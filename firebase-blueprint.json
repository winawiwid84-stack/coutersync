{
  "entities": {
    "Venue": {
      "title": "Venue",
      "description": "Partner sports venue (GOR) in Bandung with dynamic off-peak pricing settings.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "sport": { "type": "string", "enum": ["Badminton", "Futsal", "Mini Soccer", "Padel"] },
        "area": { "type": "string", "minLength": 2, "maxLength": 80 },
        "address": { "type": "string", "minLength": 5, "maxLength": 240 },
        "rating": { "type": "number" },
        "reviewCount": { "type": "integer" },
        "imageUrl": { "type": "string", "minLength": 5, "maxLength": 300 },
        "openHour": { "type": "integer" },
        "closeHour": { "type": "integer" },
        "facilities": { "type": "array" },
        "bankAccount": { "type": "string", "minLength": 3, "maxLength": 140 },
        "pricingEnabled": { "type": "boolean" },
        "pricingDays": { "type": "array" },
        "pricingStartHour": { "type": "integer" },
        "pricingEndHour": { "type": "integer" },
        "pricingDiscountPercent": { "type": "integer" },
        "pricingLabel": { "type": "string", "minLength": 1, "maxLength": 80 },
        "ownerUid": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "isPublic": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "name",
        "sport",
        "area",
        "address",
        "rating",
        "reviewCount",
        "imageUrl",
        "openHour",
        "closeHour",
        "facilities",
        "bankAccount",
        "pricingEnabled",
        "pricingDays",
        "pricingStartHour",
        "pricingEndHour",
        "pricingDiscountPercent",
        "pricingLabel",
        "isPublic"
      ]
    },
    "Court": {
      "title": "Court",
      "description": "Individual playable court belonging to a Bandung venue.",
      "type": "object",
      "properties": {
        "venueId": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "surface": { "type": "string", "minLength": 2, "maxLength": 100 },
        "indoor": { "type": "boolean" },
        "basePricePerHour": { "type": "integer" },
        "ownerUid": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "isPublic": { "type": "boolean" }
      },
      "required": ["venueId", "name", "surface", "indoor", "basePricePerHour", "isPublic"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Court reservation record (PII-protected; readable only by booking owner or venue admin).",
      "type": "object",
      "properties": {
        "bookingCode": { "type": "string", "minLength": 6, "maxLength": 32, "pattern": "^[A-Z0-9\\-]+$" },
        "venueId": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "courtId": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "date": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "hours": { "type": "array" },
        "customerName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "customerPhone": { "type": "string", "minLength": 6, "maxLength": 30 },
        "source": { "type": "string", "enum": ["online", "member", "walkin"] },
        "paymentMethod": { "type": "string", "enum": ["QRIS", "VA_BCA", "VA_MANDIRI", "VA_BNI", "KASIR_TUNAI"] },
        "totalPrice": { "type": "integer" },
        "discountApplied": { "type": "integer" },
        "paymentMode": { "type": "string", "enum": ["full", "split"] },
        "splitLink": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["confirmed", "pending_split", "cancelled"] },
        "ownerUid": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "venueOwnerUid": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "checkedInAt": { "type": "string", "maxLength": 64 },
        "openPlayId": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "bookingCode",
        "venueId",
        "courtId",
        "date",
        "hours",
        "customerName",
        "customerPhone",
        "source",
        "paymentMethod",
        "totalPrice",
        "discountApplied",
        "paymentMode",
        "status",
        "ownerUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "BookingSlot": {
      "title": "BookingSlot",
      "description": "Public, PII-free atomic lock document (ID = courtId_date_hour) enforcing anti-double-booking.",
      "type": "object",
      "properties": {
        "venueId": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "courtId": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "date": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "hour": { "type": "integer" },
        "bookingId": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "source": { "type": "string", "enum": ["online", "member", "walkin"] },
        "ownerUid": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["venueId", "courtId", "date", "hour", "bookingId", "source", "ownerUid", "createdAt"]
    },
    "BookingParticipant": {
      "title": "BookingParticipant",
      "description": "Split Bill participant payment tracker linked to a booking.",
      "type": "object",
      "properties": {
        "bookingId": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "amount": { "type": "integer" },
        "paid": { "type": "boolean" },
        "paidAt": { "type": "string", "maxLength": 64 },
        "isHost": { "type": "boolean" },
        "paymentRef": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["bookingId", "ownerUid", "name", "amount", "paid", "isHost", "createdAt", "updatedAt"]
    },
    "OpenPlaySession": {
      "title": "OpenPlaySession",
      "description": "Community Open Play (Mabar) room in Bandung.",
      "type": "object",
      "properties": {
        "bookingId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "minLength": 3, "maxLength": 140 },
        "sport": { "type": "string", "enum": ["Badminton", "Futsal", "Mini Soccer", "Padel"] },
        "venueId": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "courtId": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "date": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "hours": { "type": "array" },
        "hostName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "ownerUid": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "skillLevel": { "type": "string", "enum": ["Pemula", "Menengah", "Mahir"] },
        "maxPlayers": { "type": "integer" },
        "currentPlayers": { "type": "integer" },
        "costPerPerson": { "type": "integer" },
        "description": { "type": "string", "maxLength": 400 },
        "participantUids": { "type": "array" },
        "participantNames": { "type": "array" },
        "status": { "type": "string", "enum": ["open", "full", "closed"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "title",
        "sport",
        "venueId",
        "courtId",
        "date",
        "hours",
        "hostName",
        "ownerUid",
        "skillLevel",
        "maxPlayers",
        "currentPlayers",
        "costPerPerson",
        "description",
        "participantUids",
        "participantNames",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "LobbyMessage": {
      "title": "LobbyMessage",
      "description": "Temporary Lobby Chat message inside an Open Play room.",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderUid": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "text": { "type": "string", "minLength": 1, "maxLength": 500 },
        "isSystem": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sessionId", "senderUid", "senderName", "text", "isSystem", "createdAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted venue owner / admin role lookup document.",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["admin", "venue_owner"] }
      },
      "required": ["role"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "PII-protected user account profile with workspace role (player or mitra_gor) and server/admin-controlled verification flag.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "email": { "type": "string", "minLength": 5, "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 30 },
        "accountType": { "type": "string", "enum": ["player", "mitra_gor"] },
        "verifiedMitra": { "type": "boolean" },
        "favoriteSport": { "type": "string", "enum": ["Badminton", "Futsal", "Mini Soccer", "Padel"] },
        "skillLevel": { "type": "string", "enum": ["Pemula", "Menengah", "Mahir"] },
        "venueName": { "type": "string", "maxLength": 120 },
        "venueArea": { "type": "string", "maxLength": 80 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "accountType",
        "verifiedMitra",
        "createdAt",
        "updatedAt"
      ]
    },
    "ContentDraft": {
      "title": "ContentDraft",
      "description": "Saved AI Content Agent output package (text & storyboard metadata only, no raw media blobs) owned by a user.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "roleMode": { "type": "string", "enum": ["B2C", "B2B"] },
        "venueId": { "type": "string", "maxLength": 128 },
        "platform": { "type": "string", "minLength": 2, "maxLength": 60 },
        "tone": { "type": "string", "minLength": 2, "maxLength": 60 },
        "prompt": { "type": "string", "minLength": 2, "maxLength": 1000 },
        "mediaType": { "type": "string", "enum": ["none", "image", "video"] },
        "mediaFileName": { "type": "string", "maxLength": 180 },
        "title": { "type": "string", "minLength": 2, "maxLength": 200 },
        "hook": { "type": "string", "minLength": 2, "maxLength": 500 },
        "caption": { "type": "string", "minLength": 2, "maxLength": 3500 },
        "whatsappBroadcast": { "type": "string", "maxLength": 2000 },
        "cta": { "type": "string", "maxLength": 400 },
        "mediaAnalysis": { "type": "string", "maxLength": 1500 },
        "bestPostingTime": { "type": "string", "maxLength": 300 },
        "hashtags": { "type": "array" },
        "visualTips": { "type": "array" },
        "videoScriptJson": { "type": "string", "maxLength": 8000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerUid",
        "roleMode",
        "platform",
        "tone",
        "prompt",
        "mediaType",
        "title",
        "hook",
        "caption",
        "hashtags",
        "createdAt"
      ]
    },
    "VenueReview": {
      "title": "VenueReview",
      "description": "Player post-booking venue rating (1-5 stars) and written review for Bandung GORs.",
      "type": "object",
      "properties": {
        "venueId": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookingId": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookingCode": { "type": "string", "minLength": 4, "maxLength": 32 },
        "courtName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "ownerUid": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "reviewerName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "rating": { "type": "integer" },
        "comment": { "type": "string", "minLength": 3, "maxLength": 600 },
        "tags": { "type": "array" },
        "playedDate": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "isPublic": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "venueId",
        "bookingId",
        "bookingCode",
        "courtName",
        "ownerUid",
        "reviewerName",
        "rating",
        "comment",
        "tags",
        "playedDate",
        "isPublic",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/venues/{venueId}": {
      "schema": { "$ref": "#/entities/Venue" },
      "description": "Public Bandung venue directory with dynamic off-peak pricing configuration."
    },
    "/courts/{courtId}": {
      "schema": { "$ref": "#/entities/Court" },
      "description": "Public court catalog referencing venues."
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "PII-protected court bookings readable only by owner or venue admin."
    },
    "/booking_slots/{slotId}": {
      "schema": { "$ref": "#/entities/BookingSlot" },
      "description": "PII-free atomic court slot locks with deterministic ID courtId_date_hour preventing double-booking."
    },
    "/booking_participants/{participantId}": {
      "schema": { "$ref": "#/entities/BookingParticipant" },
      "description": "Split Bill payment tracking per participant for each booking."
    },
    "/open_plays/{sessionId}": {
      "schema": { "$ref": "#/entities/OpenPlaySession" },
      "description": "Public Open Play (Mabar) matchmaking sessions in Bandung."
    },
    "/open_plays/{sessionId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/LobbyMessage" },
      "description": "Temporary lobby chat messages scoped to Open Play sessions."
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Server-managed venue owner/admin role registry."
    },
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "PII-protected user accounts with Pemain (player) and Mitra GOR (mitra_gor) workspace roles."
    },
    "/content_drafts/{draftId}": {
      "schema": { "$ref": "#/entities/ContentDraft" },
      "description": "Owner-scoped saved AI Content Agent drafts (caption, storyboard, WhatsApp copy)."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/VenueReview" },
      "description": "Public post-booking player ratings (1-5 stars) and reviews for Bandung venues."
    }
  }
}
